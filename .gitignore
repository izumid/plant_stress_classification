# Ignore folders and its contents
/bin/
/Include/
/Lib/
/Scripts/
/share/
/-v/
/_check/
/codes/
z_img/
/data/
/exe_file/

# Ignore subfolders, but not root files
z_bat/*/


# Keep just specific folder
/data/
!/data/05_analyses

# Ignore files with extension
*.cfg
*.exe
*.spec
*.pyc

# Ignore specific files
analyses.py
log_file.txt

# Ignore .env files (but not .env.example)
!.env.example
.env